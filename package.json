{
  "name": "repa",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "dev:backend": "npm --workspace=repa run start --",
    "dev:web": "npm run dev --workspace=@repa/web",
    "precheck": "npm run build --workspace=repa",
    "pretest": "npm run build --workspace=repa",
    "start": "npm --workspace=repa run start --",
    "test": "npm run test --workspaces --if-present"
  }
}
